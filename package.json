{
  "name": "todo-devops-bun",
  "version": "1.0.0",
  "description": "Simple Todo List app with Bun runtime for learning DevOps and CI/CD",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist --minify",
    "test": "bun test"
  },
  "dependencies": {},
  "devDependencies": {}
}
